package templates

import (
	"geminirouter/pkg/config"
)

templ KeyModal(apps []config.App, key *config.APIKey) {
	<!-- Right-Hand API Key Configuration Inspector Panel -->
	<div id="create-key-modal" class="rounded-xl bg-white shadow-md border border-slate-200 overflow-hidden max-h-[calc(100vh-5rem)] flex flex-col" aria-labelledby="modal-title" role="region">
		<!-- Sticky Inspector Header Bar -->
		<div class="bg-slate-100/90 border-b border-slate-200 px-5 py-3.5 flex items-center justify-between gap-3">
			<div>
				<div class="text-[11px] font-semibold uppercase tracking-wider text-blue-600">Access Inspector</div>
				<h3 class="text-sm font-bold text-slate-900" id="modal-title">
					if key != nil {
						Edit API Key Details
					} else {
						Generate API Key Credentials
					}
				</h3>
			</div>
			<button
				type="button"
				onclick="document.querySelectorAll('[data-edit-row]').forEach(r => r.classList.remove('bg-blue-50/70', 'ring-1', 'ring-inset', 'ring-blue-500/30')); document.getElementById('create-key-modal').remove()"
				class="rounded-md p-1 text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 focus:outline-none transition"
			>
				<span class="sr-only">Close</span>
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>

		<!-- Scrollable Inspector Body -->
		<div class="p-5 overflow-y-auto">
			<p class="text-xs text-slate-500">
				if key != nil {
					Modify status and target application mapping for this API Key.
				} else {
					Select a configured Application. The generated API Key will inherit the App's rate capacity and validation rules.
				}
			</p>

			if key != nil {
				<!-- Edit Form -->
				<form
					hx-post="/admin/keys/save"
					class="mt-4 space-y-4"
				>
					<div id="error-alert-container"></div>
					<input type="hidden" name="hash" value={ key.KeyHash } />
					
					<div>
						<label class="block text-xs font-medium text-slate-500 font-semibold">Hashed Key Identifier</label>
						<div class="mt-1 font-mono text-xs bg-slate-50 p-2 rounded border border-slate-200 text-slate-700 break-all select-all">
							{ key.KeyHash }
						</div>
					</div>

					<div>
						<label for="app_id" class="block text-xs font-medium text-slate-700">Bound Application</label>
						<select name="app_id" id="app_id" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm ring-1 ring-inset ring-slate-300 p-2 text-sm">
							for _, a := range apps {
								if key.AppID == a.ID {
									<option value={ a.ID } selected>{ a.Name } ({ a.ID })</option>
								} else {
									<option value={ a.ID }>{ a.Name } ({ a.ID })</option>
								}
							}
						</select>
					</div>

					<div>
						<label for="status" class="block text-xs font-medium text-slate-700">Access Status</label>
						<select name="status" id="status" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm ring-1 ring-inset ring-slate-300 p-2 text-sm">
							if key.Status == "active" {
								<option value="active" selected>Active (Allows proxy access)</option>
								<option value="revoked">Revoked (Blocked)</option>
							} else {
								<option value="active">Active (Allows proxy access)</option>
								<option value="revoked" selected>Revoked (Blocked)</option>
							}
						</select>
					</div>

					<div class="mt-6 sm:mt-4 sm:flex sm:flex-row-reverse gap-3 border-t border-slate-200 pt-4">
						<button type="submit" class="inline-flex w-full justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 sm:w-auto transition">
							Save Key Details
						</button>
						<button
							type="button"
							onclick="document.querySelectorAll('[data-edit-row]').forEach(r => r.classList.remove('bg-blue-50/70', 'ring-1', 'ring-inset', 'ring-blue-500/30')); document.getElementById('create-key-modal').remove()"
							class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto transition"
						>
							Cancel
						</button>
					</div>
				</form>
			} else {
				<!-- Creation Form -->
				<form
					hx-post="/admin/keys/create"
					hx-target="#new-key-alert"
					hx-swap="innerHTML"
					class="mt-4 space-y-4"
				>
					<div id="error-alert-container"></div>
					<div>
						<label for="app_id" class="block text-xs font-medium text-slate-700">Select Target Application</label>
						<select name="app_id" id="app_id" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm ring-1 ring-inset ring-slate-300 p-2 text-sm">
							for _, a := range apps {
								<option value={ a.ID }>{ a.Name } ({ a.ID })</option>
							}
						</select>
					</div>

					<div class="mt-6 sm:mt-4 sm:flex sm:flex-row-reverse gap-3 border-t border-slate-200 pt-4">
						<button type="submit" class="inline-flex w-full justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 sm:w-auto transition">
							Generate Key
						</button>
						<button
							type="button"
							onclick="document.querySelectorAll('[data-edit-row]').forEach(r => r.classList.remove('bg-blue-50/70', 'ring-1', 'ring-inset', 'ring-blue-500/30')); document.getElementById('create-key-modal').remove()"
							class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto transition"
						>
							Cancel
						</button>
					</div>
				</form>
			}
		</div>
	</div>
}

templ KeyCreatedAlert(rawKey string, appName string) {
	<div class="rounded-md bg-green-50 p-4 border border-green-200 mb-6 shadow-sm">
		<script>if(document.getElementById('create-key-modal')) document.getElementById('create-key-modal').remove();</script>
		<div class="flex">
			<div class="flex-shrink-0">
				<svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
				</svg>
			</div>
			<div class="ml-3">
				<h3 class="text-sm font-medium text-green-800">API Key Provisioned Successfully</h3>
				<div class="mt-2 text-xs text-green-700 space-y-2">
					<p>
						Below is the raw API Key generated for application <span class="font-bold">{ appName }</span>.
						Please copy this key now. <strong>It will not be displayed again!</strong>
					</p>
					<div class="flex items-center justify-between gap-3 mt-2 bg-white p-3 rounded border border-green-300 font-mono text-sm font-bold text-slate-800" data-code-snippet>
						<code class="select-all break-all">{ rawKey }</code>
						<button
							type="button"
							onclick="copyCodeSnippet(this)"
							data-copy-text={ rawKey }
							title="Copy to clipboard"
							aria-label="Copy to clipboard"
							class="copy-snippet-btn shrink-0 p-1.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 border border-slate-300 transition-colors cursor-pointer"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
							</svg>
						</button>
					</div>
				</div>
				<div class="mt-4">
					<button
						type="button"
						onclick="document.getElementById('new-key-alert').innerHTML = ''"
						class="rounded-md bg-green-100 px-3 py-2 text-xs font-semibold text-green-900 hover:bg-green-200 transition"
					>
						Dismiss
					</button>
				</div>
			</div>
		</div>
	</div>
}
