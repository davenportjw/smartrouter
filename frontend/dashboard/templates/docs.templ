package templates

import (
	"fmt"
)

templ DocsTab(vm DocsViewModel) {
	<style>
		/* Custom Premium Markdown Reader Styles */
		.markdown-content {
			line-height: 1.7;
			color: #334155; /* text-slate-700 */
			font-size: 0.9375rem;
		}
		.markdown-content h1 {
			font-size: 1.625rem;
			font-weight: 800;
			color: #0f172a; /* text-slate-900 */
			margin-top: 0;
			margin-bottom: 1.25rem;
			border-bottom: 1px solid #e2e8f0;
			padding-bottom: 0.625rem;
			letter-spacing: -0.025em;
		}
		.markdown-content h2 {
			font-size: 1.25rem;
			font-weight: 700;
			color: #1e293b; /* text-slate-800 */
			margin-top: 2rem;
			margin-bottom: 0.875rem;
			padding-bottom: 0.3rem;
			border-bottom: 1px solid #f1f5f9;
			letter-spacing: -0.02em;
		}
		.markdown-content h3 {
			font-size: 1.0625rem;
			font-weight: 600;
			color: #334155;
			margin-top: 1.5rem;
			margin-bottom: 0.625rem;
		}
		.markdown-content p {
			margin-top: 0;
			margin-bottom: 1.125rem;
		}
		.markdown-content ul {
			list-style-type: disc;
			margin-top: 0;
			margin-bottom: 1.125rem;
			padding-left: 1.5rem;
		}
		.markdown-content ol {
			list-style-type: decimal;
			margin-top: 0;
			margin-bottom: 1.125rem;
			padding-left: 1.5rem;
		}
		.markdown-content li {
			margin-top: 0.3rem;
			margin-bottom: 0.3rem;
		}
		.markdown-content a {
			color: #2563eb; /* blue-600 */
			text-decoration: none;
			font-weight: 500;
			border-bottom: 1px dashed #93c5fd;
			transition: all 0.15s ease;
		}
		.markdown-content a:hover {
			color: #1d4ed8; /* blue-700 */
			border-bottom-style: solid;
		}
		.markdown-content blockquote {
			font-style: italic;
			color: #475569;
			border-left: 3px solid #2563eb; /* blue-600 */
			padding-left: 1rem;
			margin: 1.25rem 0;
			background-color: #eff6ff;
			padding-top: 0.625rem;
			padding-bottom: 0.625rem;
			padding-right: 0.75rem;
			border-radius: 0 0.375rem 0.375rem 0;
		}
		.markdown-content code {
			font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.85em;
			color: #0f172a; /* slate-900 */
			background-color: #f1f5f9; /* slate-100 */
			padding: 0.15rem 0.35rem;
			border-radius: 0.25rem;
			border: 1px solid #e2e8f0;
		}
		.markdown-content pre {
			background-color: #0f172a; /* slate-900 */
			color: #f8fafc; /* slate-50 */
			padding: 1rem 1.25rem;
			border-radius: 0.5rem;
			overflow-x: auto;
			margin: 1.25rem 0;
			border: 1px solid #1e293b;
		}
		.markdown-content pre code {
			color: inherit;
			background-color: transparent;
			padding: 0;
			border-radius: 0;
			border: none;
			font-size: 0.875em;
			line-height: 1.55;
		}
		.markdown-content hr {
			border: 0;
			border-top: 1px solid #e2e8f0;
			margin: 2rem 0;
		}
		.markdown-content table {
			width: 100%;
			border-collapse: collapse;
			margin: 1.25rem 0;
			font-size: 0.875rem;
		}
		.markdown-content th, .markdown-content td {
			border: 1px solid #e2e8f0;
			padding: 0.625rem 0.875rem;
			text-align: left;
		}
		.markdown-content th {
			background-color: #f8fafc;
			font-weight: 600;
			color: #0f172a;
		}
		.markdown-content tr:nth-child(even) td {
			background-color: rgba(248, 250, 252, 0.6);
		}
	</style>

	<div class="flex flex-1 min-h-0 w-full overflow-hidden">
		<!-- Secondary Navigation Sidebar: Flush next to #left-sidebar with identical styling -->
		<aside id="docs-sidebar" class="w-64 shrink-0 bg-slate-100 border-r border-slate-200 flex flex-col overflow-y-auto select-none p-4 space-y-6">
			for _, cat := range vm.Categories {
				<div class="space-y-1">
					<div class="px-2.5 pb-1 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
						{ cat.Name }
					</div>
					for _, item := range cat.Items {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/docs?path=%s", item.Path)) }
							class={ "flex items-center gap-2.5 px-2.5 py-1.5 rounded-r-md text-[13px] leading-5 transition-colors",
								templ.KV("bg-blue-50 text-blue-700 font-semibold border-l-2 border-blue-600", vm.ActivePath == item.Path),
								templ.KV("text-slate-700 hover:bg-slate-200/70 hover:text-slate-900 font-medium", vm.ActivePath != item.Path) }
						>
							<span class="truncate">{ item.Title }</span>
						</a>
					}
				</div>
			}
		</aside>

		<!-- Right Side: Full-Height Scrollable Markdown Document Content Viewer -->
		<div id="docs-content" class="flex-1 min-w-0 overflow-y-auto bg-white px-8 py-6">
			<article class="max-w-4xl">
				<div class="markdown-content prose max-w-none">
					@templ.Raw(vm.RenderedHTML)
				</div>
			</article>
		</div>
	</div>
}
